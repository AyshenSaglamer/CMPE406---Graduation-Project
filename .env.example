# For the full stack (docker-compose.yml in this folder). Copy to .env and set your own values. Never commit .env.
# (backend/.env.example is for running the backend alone from the IDE.)

POSTGRES_DB=diamate
POSTGRES_USER=diamate
POSTGRES_PASSWORD=change-me
# Password of diamate_app, the role the backend connects as (data only, no schema changes). Use a different value than
# POSTGRES_PASSWORD. Generate with: openssl rand -hex 24
APP_DB_PASSWORD=change-me-too

# JWT signing key (HS256): base64 of at least 32 random bytes. Generate with: openssl rand -base64 64
JWT_SECRET=change-me
# Access token lifetime; the app renews it with the refresh token, which lives JWT_REFRESH_EXPIRATION after its last use.
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Swagger UI (https://localhost:8443/swagger-ui.html) and /v3/api-docs. Keep false in production.
API_DOCS_ENABLED=false

# Production only (docker-compose.prod.yml, deploy/DEPLOYMENT.md): the domain of the API and the address that gets
# Let's Encrypt's expiry warnings. Leave empty for local development.
DOMAIN=
LETSENCRYPT_EMAIL=

# Host ports of Nginx. HTTP only redirects to HTTPS.
HTTP_PORT=8081
HTTPS_PORT=8443

# Nginx rate limit for login and registration, per client IP (Nginx syntax: 10r/m = 10 per minute)
AUTH_RATE_LIMIT=10r/m
AUTH_RATE_BURST=5

# Whisper model of the AI service (tiny, base, small, ...)
WHISPER_MODEL_SIZE=base
