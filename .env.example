# For the full stack (docker-compose.yml in this folder). Copy to .env and set your own values. Never commit .env.
# (backend/.env.example is for running the backend alone from the IDE.)

POSTGRES_DB=diamate
POSTGRES_USER=diamate
POSTGRES_PASSWORD=change-me

# JWT signing key (HS256): base64 of at least 32 random bytes. Generate with: openssl rand -base64 64
JWT_SECRET=change-me
JWT_EXPIRATION=1h

# Host ports of Nginx. HTTP only redirects to HTTPS.
HTTP_PORT=8081
HTTPS_PORT=8443

# Whisper model of the AI service (tiny, base, small, ...)
WHISPER_MODEL_SIZE=base
