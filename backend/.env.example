# Copy this file to .env and set your own values. Never commit .env.
# Read by Docker Compose (container setup) and by Spring Boot (application.yml).
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=diamate
POSTGRES_USER=diamate
POSTGRES_PASSWORD=change-me
# prefer = local Docker/Postgres; require = cloud database (Neon/Supabase)
POSTGRES_SSLMODE=prefer

# JWT signing key (HS256): base64 of at least 32 random bytes. Generate with: openssl rand -base64 64
JWT_SECRET=change-me
# Access token lifetime (Spring Duration format: 15m, 1h, ...)
JWT_EXPIRATION=1h

# FastAPI AI service (team repo: ai-service). Local: http://localhost:8000, inside Docker Compose: http://ai-service:8000
AI_SERVICE_BASE_URL=http://localhost:8000
