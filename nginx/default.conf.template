# Nginx in front of the DiaMate backend (docker-compose.yml). ${HTTPS_PORT}, ${AUTH_RATE_LIMIT} and
# ${AUTH_RATE_BURST} are filled in by the nginx image's envsubst at start; Nginx's own variables ($host, $remote_addr,
# ...) are left alone because they are not set in the container's environment.

# Do not tell clients the Nginx version.
server_tokens off;

# Login and registration: at most ${AUTH_RATE_LIMIT} requests per client IP (default 10r/m, i.e. one every 6 s), with a
# burst of ${AUTH_RATE_BURST} answered at once. The backend's account lockout (5 wrong passwords -> 15 min) protects one
# account; this slows down guessing spread over many accounts and mass registration. 10 MB holds ~160 000 IPs.
limit_req_zone $binary_remote_addr zone=diamate_auth:10m rate=${AUTH_RATE_LIMIT};
limit_req_status 429;

# HTTP: nothing is served, every request is redirected to HTTPS. 308 (not 301) keeps the method and the body, so a
# POST stays a POST. The JWT is never sent over plain HTTP to the backend.
server {
    listen 80;
    server_name _;

    location / {
        return 308 https://$host:${HTTPS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/server.crt;
    ssl_certificate_key /etc/nginx/ssl/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;

    # Nginx's default is 1 MB. POST /api/v1/ai/voice takes a recording of up to 10 MB (spring.servlet.multipart:
    # 10 MB file, 11 MB request) and POST /api/v1/ai/food a meal photo of up to 5 MB; the backend's
    # RequestSizeLimitFilter keeps the photo to 6 MB and everything else to 1 MB.
    client_max_body_size 11m;

    # Browsers must use HTTPS for this host from now on. Set here (not only by Spring Security) so Nginx's own
    # responses (413, 502, ...) carry it too; the backend's copy is hidden to avoid sending the header twice.
    # A location with its own add_header does not inherit this one, so the named locations below repeat it.
    add_header Strict-Transport-Security "max-age=31536000" always;
    proxy_hide_header Strict-Transport-Security;

    # How every request is passed to the backend (inherited by the locations below).
    proxy_set_header Host $host:${HTTPS_PORT};
    proxy_set_header X-Real-IP $remote_addr;
    # Overwritten, not appended ($proxy_add_x_forwarded_for): a client could otherwise send its own X-Forwarded-For
    # and, from a private network (10.x, 192.168.x), the backend would take that fake IP for the audit log and the
    # login lockout.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port ${HTTPS_PORT};
    # The backend waits up to 60 s for the AI service on /ai/voice (diamate.ai.voice-read-timeout); Nginx's default of
    # 60 s would cut that request off just before the backend answers.
    proxy_read_timeout 90s;
    # The backend is on the same Docker network: if it does not accept the connection within 5 s it is down, and the
    # client gets the 503 below at once instead of after Nginx's default 60 s.
    proxy_connect_timeout 5s;

    # Errors that Nginx answers itself (body too large, too many login attempts, backend not running) in the same
    # application/problem+json shape as every backend error, instead of Nginx's HTML page, so the app can read them
    # the same way.
    error_page 413 @too_large;
    error_page 429 @too_many_requests;
    error_page 502 503 504 =503 @backend_unavailable;

    location @too_large {
        default_type application/problem+json;
        add_header Strict-Transport-Security "max-age=31536000" always;
        return 413 '{"type":"about:blank","title":"Content Too Large","status":413,"detail":"The request body is larger than 11 MB"}';
    }

    # Retry-After is a fixed hint (one slot frees every 6 s at the default rate); the backend's own 429 for a locked
    # account passes through unchanged because Nginx only intercepts its own errors.
    location @too_many_requests {
        default_type application/problem+json;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Retry-After 10 always;
        return 429 '{"type":"about:blank","title":"Too Many Requests","status":429,"detail":"Too many login or registration attempts from this address. Try again shortly."}';
    }

    location @backend_unavailable {
        default_type application/problem+json;
        add_header Strict-Transport-Security "max-age=31536000" always;
        return 503 '{"type":"about:blank","title":"Service Unavailable","status":503,"detail":"The DiaMate service is currently unavailable"}';
    }

    # POST /api/v1/auth/login and /register (the only public endpoints that do work), rate limited per IP.
    location /api/v1/auth/ {
        limit_req zone=diamate_auth burst=${AUTH_RATE_BURST} nodelay;
        proxy_pass http://backend:8080;
    }

    location / {
        proxy_pass http://backend:8080;
    }
}
